---
import { Logo } from "@tchat/ui";

import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Descarga el cliente de TChat para Windows, Linux y macOS." } =
  Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321";
const accountUrl = import.meta.env.PUBLIC_ACCOUNT_URL ?? "http://localhost:4322";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="border-b border-neutral-900">
      <div class="container-page flex h-16 items-center justify-between">
        <a href={siteUrl} aria-label="TChat, inicio">
          <Logo />
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a
            class="rounded-md px-3 py-2 text-neutral-400 transition-colors hover:text-neutral-100"
            href={siteUrl}
          >
            Inicio
          </a>
          <a
            class="rounded-md bg-neutral-100 px-4 py-2 font-medium text-neutral-950 transition-colors hover:bg-white"
            href={accountUrl}
          >
            Abrir cuenta
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-neutral-900 py-10">
      <div class="container-page flex flex-col items-start justify-between gap-3 text-sm text-neutral-500 sm:flex-row sm:items-center">
        <p>TChat — binarios firmados y verificables.</p>
        <p class="font-mono">cli.tchat.ortisec.site</p>
      </div>
    </footer>
  </body>
</html>
