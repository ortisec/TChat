# Entorno
ENVIRONMENT=development
DEBUG=false

# Base de datos (PostgreSQL local de infra/compose/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://tchat:tchat@localhost:5432/tchat

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:4321,http://localhost:4322,http://localhost:4323

# Firebase
FIREBASE_PROJECT_ID=tchat-c20ce
# Opcional: solo si se usan operaciones administrativas. La verificación de ID tokens
# funciona sin service account.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Tokens del terminal
AUTH_JWT_SECRET=dev-secret-change-me-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
DEVICE_CODE_TTL_SECONDS=600
DEVICE_POLL_INTERVAL_SECONDS=5
PUBLIC_ACCOUNT_URL=http://localhost:4322
