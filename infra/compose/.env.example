# Copia este archivo a infra/compose/.env en el VPS. Nunca lo subas al repositorio.

# Imagen
TAG=latest

# PostgreSQL
POSTGRES_USER=tchat
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=tchat

# API
AUTH_JWT_SECRET=cambia-por-32-caracteres-aleatorios
FIREBASE_PROJECT_ID=tchat-c20ce
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
CORS_ORIGINS=https://tchat.site,https://app.tchat.site,https://cli.tchat.site
PUBLIC_ACCOUNT_URL=https://app.tchat.site

# TLS de Caddy (Let's Encrypt)
ACME_EMAIL=tu@correo.com
